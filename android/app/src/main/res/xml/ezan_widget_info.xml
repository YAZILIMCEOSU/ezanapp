<?xml version="1.0" encoding="utf-8"?>
<!-- Ana ekran widget'ı tanımı: 4x2 hücre, yarım saatte bir otomatik yenileme -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
